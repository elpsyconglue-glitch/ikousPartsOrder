{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in the organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "department": { "type": "string" },
        "role": { "type": "string", "enum": ["システム管理者", "一般ユーザー"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" },
        "lastVerifiedAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection"
    }
  }
}
